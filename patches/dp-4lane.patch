diff --git a/kernel/drivers/gpu/drm/msm/dp/dp_panel.c b/kernel/drivers/gpu/drm/msm/dp/dp_panel.c
index 204752bad..03ca2f0c9 100644
--- a/kernel/drivers/gpu/drm/msm/dp/dp_panel.c
+++ b/kernel/drivers/gpu/drm/msm/dp/dp_panel.c
@@ -16,6 +16,20 @@
 
 #include "dp_panel.h"
 #include <drm/drm_fixed.h>
+#include <linux/module.h>
+
+/*
+ * hotdogb / HUAWEI VR Glass: keep every lane advertised by the sink even
+ * when the Type-C PD stack reports a multi-function (USB3 + DP) alt mode.
+ * The SM8150 combo PHY is already switched to DP-only mode by
+ * dp_catalog_ctrl_usb_reset(), so clamping to 2 lanes only throws away
+ * bandwidth: 3200x1600@70 was being pushed from 24bpp down to 18bpp.
+ * Set to 0 to restore the stock 2-lane behaviour without rebuilding.
+ */
+bool dp_force_4lanes = true;
+module_param(dp_force_4lanes, bool, 0644);
+MODULE_PARM_DESC(dp_force_4lanes,
+	"Use all lanes advertised by the sink in multi-function DP mode");
 
 #define DP_KHZ_TO_HZ 1000
 #define DP_PANEL_DEFAULT_BPP 24
@@ -1656,12 +1670,13 @@ static int dp_panel_read_dpcd(struct dp_panel *dp_panel, bool multi_func)
 
 	link_info->num_lanes = dpcd[DP_MAX_LANE_COUNT] &
 				DP_MAX_LANE_COUNT_MASK;
-	if (multi_func)
+	if (multi_func && !dp_force_4lanes)
 		link_info->num_lanes = min_t(unsigned int,
 			link_info->num_lanes, 2);
 
-	pr_debug("version:%d.%d, rate:%d, lanes:%d\n", panel->major,
-		panel->minor, link_info->rate, link_info->num_lanes);
+	pr_debug("version:%d.%d, rate:%d, lanes:%d (multi_func=%d, clamp=%d)\n",
+		panel->major, panel->minor, link_info->rate,
+		link_info->num_lanes, multi_func, !dp_force_4lanes);
 
 	if (drm_dp_enhanced_frame_cap(dpcd))
 		link_info->capabilities |= DP_LINK_CAP_ENHANCED_FRAMING;
diff --git a/kernel/drivers/gpu/drm/msm/dp/dp_usbpd.c b/kernel/drivers/gpu/drm/msm/dp/dp_usbpd.c
index 64c2366b5..ae8c09f61 100644
--- a/kernel/drivers/gpu/drm/msm/dp/dp_usbpd.c
+++ b/kernel/drivers/gpu/drm/msm/dp/dp_usbpd.c
@@ -20,6 +20,9 @@
 
 #include "dp_usbpd.h"
 
+/* Defined in dp_panel.c; hotdogb 4-lane override (dp_force_4lanes). */
+extern bool dp_force_4lanes;
+
 /* DP specific VDM commands */
 #define DP_USBPD_VDM_STATUS	0x10
 #define DP_USBPD_VDM_CONFIGURE	0x11
@@ -183,13 +186,23 @@ static u32 dp_usbpd_gen_config_pkt(struct dp_usbpd_private *pd)
 	else
 		pin_cfg = pd->cap.dlink_pin_config;
 
-	for (pin = DP_USBPD_PIN_A; pin < DP_USBPD_PIN_MAX; pin++) {
-		if (pin_cfg & BIT(pin)) {
-			if (pd->dp_usbpd.base.multi_func) {
-				if (pin == DP_USBPD_PIN_D)
+	/*
+	 * hotdogb: the glasses advertise 4 DP lanes (DPCD 0x002 = 0xc4).
+	 * Prefer pin assignment D (4 DP lanes + USB2) over the multi-function
+	 * C (2 DP lanes + USB3) when the partner supports it, otherwise keep
+	 * the stock selection so this stays safe for other cables.
+	 */
+	if (dp_force_4lanes && (pin_cfg & BIT(DP_USBPD_PIN_D))) {
+		pin = DP_USBPD_PIN_D;
+	} else {
+		for (pin = DP_USBPD_PIN_A; pin < DP_USBPD_PIN_MAX; pin++) {
+			if (pin_cfg & BIT(pin)) {
+				if (pd->dp_usbpd.base.multi_func) {
+					if (pin == DP_USBPD_PIN_D)
+						break;
+				} else {
 					break;
-			} else {
-				break;
+				}
 			}
 		}
 	}
